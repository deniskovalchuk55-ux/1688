{
  "name": "trend-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "collect": "node -e \"import('dotenv/config').then(()=>import('./collect.js')).then(m=>m.collectTrends()).then(()=>process.exit(0))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-trends-api": "^4.9.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
